# Copy this file to .env and fill in real values before running the server.

# Port the server listens on
PORT=4000

# Comma-separated list of allowed frontend origins, e.g.:
# CORS_ORIGIN=https://your-shop-domain.com,https://www.your-shop-domain.com
# Use * only for local testing.
CORS_ORIGIN=*

# Optional: require this exact value in the x-api-key header on every
# request. Leave blank/unset to disable auth (fine for local dev only).
API_KEY=
